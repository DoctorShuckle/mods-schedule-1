<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests. They compile only the game-free source files, so they run anywhere; the canary
       tests read the DLLs under lib/ (metadata only, nothing is executed) and skip without them. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <RootNamespace>TidyStreets.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <SrcDir>$(MSBuildThisFileDirectory)..\src\common\</SrcDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Add a file here only if it references no game, Unity or MelonLoader type. -->
    <Compile Include="$(SrcDir)Rules\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The canary finds lib/ from here (no hard-coded path in the test code). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LibDir</_Parameter1>
      <_Parameter2>$(LibDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
