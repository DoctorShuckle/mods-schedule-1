out/
bin/
obj/
__pycache__/
Latest.log

# Game and MelonLoader files: never commit. Each folder's contents are ignored but its README.md
# stays tracked. lib/shared/ is our own code and is not listed, so it is committed.
lib/mono/**
lib/il2cpp/**
lib/melonloader-mono/**
lib/melonloader-il2cpp/**
!lib/*/README.md

# Decompiled game code: never commit (README.md files stay tracked).
decompiled/**
!decompiled/**/
!decompiled/*/README.md

# Other people's mods: never commit.
third-party/

# Machine-specific settings
etc/local.json
.vscode/

# Script logs
logs/
